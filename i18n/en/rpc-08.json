 },
 {
  "id": "personalAccessTokenDetailed",
  "source": "To see private repositories you need a Personal Access Token with access right for the API."
 },
 {
  "id": "personalAccessTokenCreationStep1",
  "source": "Log in to fischertechnik GitLab."
 },
 {
  "id": "personalAccessTokenCreationStep2",
  "source": "In the upper-right corner, click your avatar and select Settings."
 },
 {
  "id": "personalAccessTokenCreationStep3",
  "source": "On the User Settings menu, select Access Tokens."
 },
 {
  "id": "personalAccessTokenCreationStep4",
  "source": "Choose a name and optional expiry date for the token."
 },
 {
  "id": "personalAccessTokenCreationStep5",
  "source": "Choose the desired scopes."
 },
 {
  "id": "personalAccessTokenCreationStep6",
  "source": "Click the Create personal access token button."
 },
 {
  "id": "personalAccessTokenCreationStep7",
  "source": "Save the personal access token somewhere safe. Once you leave or refresh the page, you won’t be able to access it again."
 },
